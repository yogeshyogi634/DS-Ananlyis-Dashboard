# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Secret for OAuth state verification
JWT_SECRET=your-secret-jwt-key-here

# Frontend URL (for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:3000

# Figma OAuth Configuration
FIGMA_CLIENT_ID=your_figma_client_id_here
FIGMA_CLIENT_SECRET=your_figma_client_secret_here
FIGMA_REDIRECT_URI=http://localhost:3001/api/oauth/callback

# Optional: Figma Personal Access Token (fallback)
FIGMA_ACCESS_TOKEN=figd_your_figma_personal_access_token_here